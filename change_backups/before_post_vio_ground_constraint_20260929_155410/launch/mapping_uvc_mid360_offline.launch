<launch>
  <!-- Offline replay only: sensor drivers and RViz are intentionally absent. -->
  <arg name="pcd_output_dir" required="true" />
  <arg name="pcd_interval" default="200" />
  <arg name="ground_velocity_constraint_en" default="false" />
  <arg name="ground_velocity_sigma" default="0.08" />
  <arg name="innovation_csv_path" default="/home/nuc/versions/version5/logs/lio_innovation_offline.csv" />

  <rosparam command="load" file="$(find fast_livo)/config/uvc_mid360.yaml" />
  <param name="lio/ground_velocity_constraint_en" type="bool" value="$(arg ground_velocity_constraint_en)" />
  <param name="lio/ground_velocity_sigma" type="double" value="$(arg ground_velocity_sigma)" />
  <param name="lio/innovation_csv_path" type="string" value="$(arg innovation_csv_path)" />
  <param name="pcd_save/output_dir" type="string" value="$(arg pcd_output_dir)" />
  <param name="pcd_save/interval" type="int" value="$(arg pcd_interval)" />
  <param name="pcd_save/colmap_output_en" type="bool" value="false" />

  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <rosparam file="$(find fast_livo)/config/camera_uvc.yaml" />
  </node>
</launch>
