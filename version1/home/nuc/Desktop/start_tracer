#!/usr/bin/env bash
set -euo pipefail

IFACE="${1:-${IFACE:-can0}}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! ip link show "$IFACE" >/dev/null 2>&1; then
  echo "ERROR: CAN interface '$IFACE' not found." >&2
  echo "Run: bash $SCRIPT_DIR/setup_tracer_can $IFACE" >&2
  exit 1
fi

if ! ip -details link show "$IFACE" | grep -q "state ERROR-ACTIVE"; then
  echo "ERROR: CAN interface '$IFACE' is not up/active." >&2
  echo "Run: bash $SCRIPT_DIR/setup_tracer_can $IFACE" >&2
  exit 1
fi

source /opt/ros/noetic/setup.bash
source "$HOME/catkin_ws/devel/setup.bash"

exec roslaunch tracer_bringup tracer_robot_base.launch port_name:="$IFACE"
